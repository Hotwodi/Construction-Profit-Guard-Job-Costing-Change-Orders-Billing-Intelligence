<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cpg_change_order_view_tree" model="ir.ui.view">
        <field name="name">cpg.change.order.view.tree</field>
        <field name="model">cpg.change.order</field>
        <field name="arch" type="xml">
            <list string="Change Orders">
                <field name="co_number"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="estimated_cost" sum="Total Estimated"/>
                <field name="approved_cost" sum="Total Approved"/>
                <field name="status" widget="badge"/>
                <field name="customer_approved"/>
                <field name="approved_date"/>
            </list>
        </field>
    </record>

    <record id="cpg_change_order_view_form" model="ir.ui.view">
        <field name="name">cpg.change.order.view.form</field>
        <field name="model">cpg.change.order</field>
        <field name="arch" type="xml">
            <form string="Change Order">
                <header>
                    <button name="action_set_estimated" type="object" string="Set Estimated" invisible="status != 'requested'"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="status not in ['requested','estimated']"/>
                    <button name="action_reject" type="object" string="Reject" invisible="status in ['approved','invoiced']"/>
                    <button name="action_invoice" type="object" string="Mark Invoiced" class="oe_highlight" invisible="status != 'approved'"/>
                    <field name="status" widget="statusbar" statusbar_visible="requested,estimated,approved,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Additional Electrical Rough-In"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="co_number"/>
                            <field name="project_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="estimated_cost"/>
                            <field name="approved_cost"/>
                            <field name="customer_approved"/>
                            <field name="approved_date"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="AI Detection">
                        <field name="ai_detected_from" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="cpg_change_order_view_search" model="ir.ui.view">
        <field name="name">cpg.change.order.view.search</field>
        <field name="model">cpg.change.order</field>
        <field name="arch" type="xml">
            <search string="Change Orders">
                <field name="name"/>
                <field name="co_number"/>
                <field name="project_id"/>
                <filter name="filter_requested" string="Requested" domain="[('status', '=', 'requested')]"/>
                <filter name="filter_estimated" string="Estimated" domain="[('status', '=', 'estimated')]"/>
                <filter name="filter_approved" string="Approved" domain="[('status', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('status', '=', 'rejected')]"/>
                <filter name="filter_invoiced" string="Invoiced" domain="[('status', '=', 'invoiced')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="cpg_change_order_action" model="ir.actions.act_window">
        <field name="name">Change Orders</field>
        <field name="res_model">cpg.change.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="cpg_change_order_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new change order
            </p>
        </field>
    </record>
</odoo>
